<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.klsjnh</groupId>
        <artifactId>java17-framework011</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>java17-app011</artifactId>
    <packaging>jar</packaging>

    <!-- Reference application: the only main class, profile configuration,
         demo vertical slice (demo11) and the demo account seed. Copy this
         assembly shape when scaffolding a business project. -->
    <dependencies>
        <dependency>
            <groupId>com.klsjnh</groupId>
            <artifactId>java17-core011</artifactId>
        </dependency>
        <dependency>
            <groupId>com.klsjnh</groupId>
            <artifactId>java17-security-starter011</artifactId>
        </dependency>
        <dependency>
            <groupId>com.klsjnh</groupId>
            <artifactId>java17-data-mybatis011-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.klsjnh</groupId>
            <artifactId>center-datasource011-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.klsjnh</groupId>
            <artifactId>center-access011-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.klsjnh</groupId>
            <artifactId>center-platform011-starter</artifactId>
        </dependency>
                <!-- NEG-TEST-OFF: center-storage011-starter -->
        <dependency>
            <groupId>com.klsjnh</groupId>
            <artifactId>java17-scheduler-quartz011-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.klsjnh</groupId>
            <artifactId>center-message011-starter</artifactId>
        </dependency>
        <!-- NEG-TEST-OFF: center-ai011-starter -->
        <dependency>
            <groupId>com.klsjnh</groupId>
            <artifactId>java17-observability011-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
          gitignore 只挡 git 提交，不挡 Maven 打包。
          本机私有 / 生产部署配置必须在 resources excludes 里排除，否则仍会进 fat jar。
          保留：application.yml（公共结构）、application-development.yml（开发共享基线）。
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>application-local*.yml</exclude>
                    <exclude>application-local*.yaml</exclude>
                    <exclude>application-local*.properties</exclude>
                    <exclude>application-production*.yml</exclude>
                    <exclude>application-production*.yaml</exclude>
                    <exclude>application-production*.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
                        <plugin>
                <!-- 正常 install 不发布本应用到 .m2；演示播种在 test 域，仅测试阶段运行 -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
<plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
