<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.klsjnh</groupId>
    <artifactId>java17-framework011</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- Pure aggregator: version management lives in java17-bom011 (consumers
         import the BOM), build plugin management stays here for the reactor. -->
    <modules>
        <module>java17-bom011</module>
        <module>java17-security-api011</module>
        <module>java17-core011</module>
        <module>java17-security-autoconfigure011</module>
        <module>java17-security-starter011</module>
        <module>java17-data-mybatis011-starter</module>
        <module>center-datasource011-starter</module>
        <module>center-storage011-starter</module>
        <module>center-access011-starter</module>
        <module>center-platform011-starter</module>
        <module>java17-scheduler-quartz011-starter</module>
        <module>center-message011-starter</module>
        <module>center-ai011-starter</module>
        <module>java17-observability011-starter</module>
        <module>java17-app011</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 技术底座基线：Java 17 + MyBatis-Plus + MySQL + Swagger(knife4j/springdoc) + JWT -->
        <spring-boot.version>3.4.5</spring-boot.version>
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <druid.version>1.2.23</druid.version>
        <mysql.version>8.3.0</mysql.version>
        <ojdbc.version>21.5.0.0</ojdbc.version>
        <mssql-jdbc.version>12.8.1.jre11</mssql-jdbc.version>
        <lombok.version>1.18.36</lombok.version>
        <jjwt.version>0.12.6</jjwt.version>
        <knife4j.version>4.5.0</knife4j.version>
        <springdoc.version>2.8.9</springdoc.version>
        <swagger-annotations.version>2.2.25</swagger-annotations.version>
        <minio.version>8.5.7</minio.version>
        <poi.version>5.2.5</poi.version>
        <commons-compress.version>1.26.2</commons-compress.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- single source of truth for versions: the BOM module -->
            <dependency>
                <groupId>com.klsjnh</groupId>
                <artifactId>java17-bom011</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <encoding>${maven.compiler.encoding}</encoding>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <!-- Pinned to 3.3.0: 3.3.1+ fails on WSL 9p mounts (Operation not permitted) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.0</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
