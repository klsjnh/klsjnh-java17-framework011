# Local / WSL development overrides for java17-app011 (copy to .env or export).
# Defaults in application-development.yml keep the app runnable without this file.
# NEVER commit real production secrets here.

# MySQL (host 33306 → docker klsjnh-framework011-mysql)
KLSJNH_DB_USERNAME=dev202608011
KLSJNH_DB_PASSWORD=dev202608011

# Druid console (/druid)
KLSJNH_DRUID_USERNAME=klsjnh
KLSJNH_DRUID_PASSWORD=klsjnh

# Runtime mode: debug | development | production
# debug = auth filter does not reject; assertHas is no-op (dev convenience ONLY)
KRT_STATUS=debug

# JWT (must be long / random in any shared or remote environment)
KRT_JWT_SECRET=dev-secret-klsjnh-framework011-20260912-change-me-in-production-0123456789
KRT_JWT_EXPIRE_MINUTES=480

# SecretCipher AES-256-GCM master key (≥32 bytes)
KRT_CRYPTO_MASTER_KEY=dev-crypto-master-key-klsjnh-framework011-change-me-32b

# Optional MinIO seed defaults (when using minio011)
KLSJNH_MINIO_ENDPOINT=http://192.168.1.88:11230
KLSJNH_MINIO_ACCESS_KEY=demo011
KLSJNH_MINIO_SECRET_KEY=123456789
KLSJNH_MINIO_DEFAULT_BUCKET=demo011
