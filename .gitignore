# ---- 本地私有配置（application.yml 公共结构正常提交）----
# 通配忽略所有环境 yml，仅 application-development.yml（开发共享）入库；
# application-local.yml（本机私有覆盖）与 application-production.yml 均被下面的通配规则忽略
application-*.yml
application-*.yaml
!application-development.yml
*.local

# ---- node（AST 门禁依赖：tools/package.json → tools/node_modules，不入库）----
node_modules/

# ---- 本地备份（不入库）----
.backup011/

# ---- deploy runtime (logs/data/storage) —— 落地件在 docs/deploy/ ----
docs/deploy/runtime/
docs/deploy/java011/
